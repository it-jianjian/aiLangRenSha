# .env — AI 狼人杀本地环境变量（不提交到仓库）
# 复制为 .env 后修改

# === 数据库 ===
# 默认本地 SQLite（免配置）：
DATABASE_URL=sqlite+aiosqlite:///./data/werewolf.db
# 本地 MySQL（先建库: CREATE DATABASE ai_langrensha CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;）
# 异步驱动 aiomysql，同步/迁移会自动转 pymysql；LangGraph 检查点也随之落到 MySQL：
# DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@localhost:3306/ai_langrensha?charset=utf8mb4

# === LLM 模型 (DeepSeek) ===
# 获取 API Key: https://platform.deepseek.com/
# deepseek-chat = DeepSeek-V3 (对话), deepseek-reasoner = DeepSeek-R1 (推理)
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=15

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === 按决策类型路由模型（阶段 3） ===
# 空字符串 = 不启用（回退默认模型）
# 简单决策（kill/verify/save/poison/vote/guard/hunter_shoot）可使用较小/较便宜的模型
# LLM_ACTION_SIMPLE_MODEL=Qwen/Qwen2.5-7B-Instruct
# 发言类决策（speech/last_words）需要强语言能力的模型
# LLM_ACTION_SPEECH_MODEL=Qwen/Qwen3.5-Instruct

# === Prompt 膨胀治理（阶段 4a） ===
# 历史轮次字符数预算，超出时用小模型压缩为摘要
# PROMPT_HISTORY_BUDGET=3000

# === 服务 ===
HOST=0.0.0.0
PORT=8000
